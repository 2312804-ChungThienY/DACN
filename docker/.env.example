# Cấu hình cho docker compose. Sao chép thành docker/.env rồi điền. KHÔNG commit docker/.env.
#   docker compose --env-file docker/.env up --build -d

# Khóa ký JWT (>= 32 ký tự). Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_JWT_SECRET=

# Mật khẩu ban đầu của tài khoản admin và giảng viên gv.* (>= 8 ký tự)
BACKEND_SEED_PASSWORD=

# Mật khẩu PostgreSQL trong container (không mở cổng ra ngoài)
POSTGRES_PASSWORD=lms_local_only

# Cổng web trên máy
WEB_PORT=8080

# Thời điểm tham chiếu dữ liệu demo (để trống = thời gian thực) và ngày bắt đầu nạp lịch sử
LMS_AS_OF=2026-11-06T10:30:00+07:00
BACKFILL_FROM=2026-09-07

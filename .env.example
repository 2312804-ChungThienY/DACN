# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# ===== CSDL phân tích (đích của ETL: 3 bảng fact) – PostgreSQL 18 local =====
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=lms_analytics
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=
# Database có sẵn dùng để kết nối khi cần tạo lms_analytics lần đầu
ANALYTICS_DB_MAINTENANCE_DB=postgres

# ===== CSDL nguồn Moodle rút gọn (bảng mdl_*) – dùng từ Bước 2 =====
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodle_src
MOODLE_DB_USER=postgres
MOODLE_DB_PASSWORD=
MOODLE_DB_MAINTENANCE_DB=postgres

# ===== Ứng dụng =====
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Thời điểm tham chiếu thay cho now() của mock data và ETL (ISO 8601).
#   Để trống            -> dùng thời gian thực (vận hành thật).
#   2026-11-06T10:30:00+07:00 -> demo giữa học kỳ (tuần 9 của HK1 bắt đầu 07/09/2026).
LMS_AS_OF=2026-11-06T10:30:00+07:00

# ===== Backend API – Bước 3 =====
# Khóa ký JWT, BẮT BUỘC, >= 32 ký tự. Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_JWT_SECRET=
BACKEND_JWT_EXPIRE_MINUTES=480
# Các origin frontend được gọi API (phân tách bằng dấu phẩy)
BACKEND_CORS_ORIGINS=http://localhost:5173
BACKEND_CACHE_TTL_SECONDS=60
# Font TrueType có dấu tiếng Việt cho PDF (để trống: Arial trên Windows / DejaVu Sans trên Linux)
BACKEND_PDF_FONT=
BACKEND_PDF_FONT_BOLD=
BACKEND_PDF_MAX_ROWS=5000
BACKEND_EXCEL_MAX_ROWS=200000
# Mật khẩu ban đầu khi chạy: python -m backend.app.cli sync-users
BACKEND_SEED_PASSWORD=
